# PostgreSQL details. Do not use the CloudBeaver website address here.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=postgres
DB_USER=student
DB_PASSWORD=change_me
DB_SSLMODE=prefer

# true uses example data. false reads PostgreSQL.
DASHBOARD_USE_DEMO_DATA=false

# true shows example data if PostgreSQL cannot be reached.
DASHBOARD_ALLOW_DEMO_FALLBACK=true
