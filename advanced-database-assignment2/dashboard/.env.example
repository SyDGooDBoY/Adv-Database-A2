# Underlying PostgreSQL connection used by CloudBeaver (not the CloudBeaver web URL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=advanced_database_a2
DB_USER=postgres
DB_PASSWORD=change_me
DB_SSLMODE=prefer

# false = read PostgreSQL; true = use the built-in deterministic synthetic demo
DASHBOARD_USE_DEMO_DATA=false

# If PostgreSQL is unreachable, show labelled demo data instead of stopping
DASHBOARD_ALLOW_DEMO_FALLBACK=true
